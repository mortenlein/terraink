# Copy to infra/.env (gitignored), chmod 600. Every variable may stay empty: the defaults are in
# server/config.ts (the self-hosted tiles service and Kartverket's address API).
# TileJSON of an OpenMapTiles-schema vector source; empty = http://gable-maps-tiles:3000/norway
TILE_URL=
# Glyph PBF template ({fontstack}, {range}); empty = the tiles service's /font/{fontstack}/{range}
GLYPHS_URL=
# Kartverket's address API base; empty = https://api.kartverket.no/adresser/v1
GEOCODER_URL=
# Overrides the TileJSON attribution drawn on every image; empty = read it from the TileJSON
MAP_ATTRIBUTION=
# Where infra/build-tiles.sh wrote norway.mbtiles and fonts/; empty = infra/tiles
TILES_DIR=
